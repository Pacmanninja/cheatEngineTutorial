label(code)
label(return)
label(skipDamage)

newmem:
   cmp dword ptr [rbx+14],1
   je skipDamage

code:
  movss [rbx+08],xmm0
  jmp return

skipDamage:
  jmp return

TUT8:
  jmp newmem
return:
registersymbol(TUT8)

[DISABLE]

TUT8:
